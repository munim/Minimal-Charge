project.manifest = manifest.xml

base.sourcePath = source
base.resourcePath = resources

# Resolution buckets for pre-baked JetBrains Mono Light 300 (0-9) bitmap fonts
round-218x218.resourcePath = $(base.resourcePath);resources-218-240
round-240x240.resourcePath = $(base.resourcePath);resources-218-240
round-260x260.resourcePath = $(base.resourcePath);resources-260-280
round-280x280.resourcePath = $(base.resourcePath);resources-260-280
round-360x360.resourcePath = $(base.resourcePath);resources-320-360
round-390x390.resourcePath = $(base.resourcePath);resources-390-416
round-416x416.resourcePath = $(base.resourcePath);resources-390-416
round-454x454.resourcePath = $(base.resourcePath);resources-454

# Square / Rectangular 40% dial width bitmap font buckets
rectangle-240x240.resourcePath = $(base.resourcePath);resources-rect-240
rectangle-320x360.resourcePath = $(base.resourcePath);resources-rect-320
rectangle-448x486.resourcePath = $(base.resourcePath);resources-rect-448
