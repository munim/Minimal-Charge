<settings xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="https://developer.garmin.com/downloads/connect-iq/resources.xsd">
    <setting propertyKey="@Properties.Slot1" title="@Strings.Slot1Title">
        <settingConfig type="list">
            <listEntry value="0">@Strings.SlotOff</listEntry>
            <listEntry value="1">@Strings.SlotDate</listEntry>
            <listEntry value="2">@Strings.SlotSteps</listEntry>
            <listEntry value="3">@Strings.SlotBattery</listEntry>
            <listEntry value="4">@Strings.SlotHeartRate</listEntry>
            <listEntry value="5">@Strings.SlotWeather</listEntry>
        </settingConfig>
    </setting>

    <setting propertyKey="@Properties.Slot2" title="@Strings.Slot2Title">
        <settingConfig type="list">
